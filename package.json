{
  "name": "brydge-langchain",
  "version": "0.2.0",
  "description": "LangChain middleware and tools for BRYDGE: supervise an agent's tool calls, then check against the destination's own records whether the work actually happened.",
  "keywords": [
    "langchain",
    "langchainjs",
    "middleware",
    "agents",
    "tools",
    "verification",
    "supervision",
    "brydge"
  ],
  "homepage": "https://github.com/contactkontey-dotcom/langchain-brydge#readme",
  "bugs": {
    "url": "https://github.com/contactkontey-dotcom/langchain-brydge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contactkontey-dotcom/langchain-brydge.git"
  },
  "license": "MIT",
  "author": "BRYDGE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit_tests",
    "test:int": "vitest run tests/integration_tests",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.39",
    "langchain": "^1.3.0"
  },
  "dependencies": {
    "zod": "^3.25.76 || ^4"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.12",
    "@types/node": "^22.20.4",
    "langchain": "^1.5.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
